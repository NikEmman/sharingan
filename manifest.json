{
  "manifest_version": 3,
  "name": "Sharingan",
  "version": "2.0",
  "description": "Save the current tab as numbered steps: the page and every frame, with typed and selected values kept.",
  "homepage_url": "https://github.com/NikEmman/sharingan",

  "icons": {
    "48": "icons/sharingan-48.png"
  },

  "action": {
    "default_icon": {
      "32": "icons/sharingan-32.png"
    },
    "default_title": "sharingan",
    "default_popup": "popup/popup.html"
  },

  "permissions": ["activeTab", "downloads", "scripting", "notifications", "storage"],

  "host_permissions": ["<all_urls>"],

  "browser_specific_settings": {
    "gecko": {
      "id": "sharingan@nikemman",
      "strict_min_version": "109.0"
    }
  }
}
